{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v pwsh >/dev/null 2>&1 && pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/limit-guard.ps1\" || exit 0",
            "commandWindows": "powershell -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\limit-guard.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking rate limits..."
          }
        ]
      }
    ]
  }
}
